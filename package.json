{
  "name": "@pengying/clawser",
  "version": "0.5.0",
  "description": "Clawser: secure human takeover links for an existing OpenClaw browser tab, with optional noVNC desktop",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "files": [
    "index.mjs",
    "src",
    "public",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "bin",
    "runtime",
    "docs/install.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "scripts"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:live": "node test/live-browser.mjs",
    "demo": "node test/demo.mjs",
    "start": "node src/dev.mjs",
    "test:runtime": "node --test runtime/desktop/test/*.test.mjs",
    "setup": "node bin/clawser.mjs setup",
    "doctor": "node bin/clawser.mjs doctor",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.9.6"
    },
    "install": {
      "minHostVersion": ">=2026.10.4"
    },
    "build": {
      "openclawVersion": "2026.10.4"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pengying/clawser.git"
  },
  "homepage": "https://github.com/pengying/clawser#readme",
  "bugs": {
    "url": "https://github.com/pengying/clawser/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "browser",
    "novnc",
    "remote-desktop"
  ],
  "bin": {
    "clawser": "./bin/clawser.mjs"
  }
}
